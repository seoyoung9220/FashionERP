# 이 파일을 .env 로 복사해서 값을 채웁니다. .env 는 커밋하지 않습니다.

# ─── 백엔드 전용 ──────────────────────────────────────────────
# AI API 키. 백엔드에서만 사용합니다.
# 🔴 프론트엔드 코드에 절대 넣지 않습니다. VITE_ 접두사를 붙이지 않습니다.
LLM_API_KEY=
LLM_MODEL=

DATABASE_URL=sqlite:///./fashion_erp.db

# ─── 프론트엔드 (VITE_ 접두사는 브라우저에 노출됨) ──────────────
# VITE_ 가 붙은 값은 번들에 그대로 들어가 누구나 볼 수 있습니다.
# 비밀 값을 여기에 두지 않습니다.
VITE_API_BASE_URL=http://localhost:8000
